# Node / npm
node_modules/
npm-debug.log*
# package-lock.json is intentionally not committed: marp-cli sometimes has to be
# installed via a mirror registry (see the README install note), and the mirror URL
# would then be baked into the lockfile. CI installs with a registry fallback.
package-lock.json

# Build output (the rendered deck and the handout PDFs)
dist/

# Editor / OS cruft
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/

# Marp local cache
.marp/

# Private planning documents and the facilitator's local prep note: never part of
# the public kit.
*.docx
preparatory resource.txt
